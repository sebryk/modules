{
   "endOfLine": "lf",
   "singleQuote": true,
   "tabWidth": 3,
   "bracketSpacing": true,
   "semi": false,
   "trailingComma": "all",
   "arrowParens": "always",
   "printWidth": 100,
   "plugins": ["prettier-plugin-tailwindcss"],
   "tailwindStylesheet": "src/app/styles/index.css",
   "tailwindFunctions": ["cn", "cva"]
}
