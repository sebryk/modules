{
   "compilerOptions": {
      "module": "commonjs",
      "declaration": true,
      "removeComments": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "allowSyntheticDefaultImports": true,
      "target": "ES2022",
      "sourceMap": true,
      "outDir": "./dist",
      "incremental": true,
      "skipLibCheck": true,
      "strict": true,
      "moduleResolution": "node",
      "esModuleInterop": true,
      "ignoreDeprecations": "6.0",
      "types": ["node", "jest"]
   },
   "include": [
      "src/**/*.ts",
      "prisma/**/*.ts",
      "prisma.config.ts",
      "test/**/*.ts"
   ],
   "exclude": ["node_modules", "dist"]
}
